{
  "model_name": "microsoft/deberta-v3-base",
  "evaluation_protocol": "5-fold StratifiedGroupKFold",
  "group_column": "context_id",
  "seed": 42,
  "max_length": 512,
  "batch_size": 4,
  "phase_1": {
    "encoder_frozen": true,
    "epochs": 10,
    "head_learning_rate": 5e-05
  },
  "phase_2": {
    "encoder_frozen": false,
    "epochs": 5,
    "encoder_learning_rate": 1e-06,
    "head_learning_rate": 5e-05
  },
  "warmup_ratio": 0.1,
  "weight_decay": 0.01,
  "optimizer": "AdamW"
}